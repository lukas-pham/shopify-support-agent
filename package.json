{
  "name": "shopify-support-agent",
  "private": true,
  "type": "module",
  "description": "Storefront support agent for Shopify: answers from real product, policy and order data through a fixed set of tools, verifies order access in code, and hands off to a human.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "eval": "tsx src/eval.ts",
    "build:playground": "esbuild src/playground.ts --bundle --format=iife --global-name=SupportPlayground --platform=browser --target=es2020 --minify --legal-comments=none --outfile=dist/support-playground.js",
    "sample-data": "node scripts/build-sample-store.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^4.21.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
