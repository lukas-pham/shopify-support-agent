# Leave empty to run in demo mode (scripted router, same tools and guards).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low keeps chat replies fast; raise to medium if answers need more care.
LLM_EFFORT=low

# Where data comes from:
#   sample    -> data/sample-store.json (offline)
#   mockshop  -> products live from the public mock.shop Storefront API, orders from the sample file
#   shopify   -> a real store through the Admin GraphQL API (custom app token)
STORE_BACKEND=sample
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10

# App proxy signature check (the app's client secret). Required in production.
SHOPIFY_API_SECRET=
PORT=8790
# Optional: POST each handoff to this URL (Slack/Gorgias/Zendesk webhook)
HANDOFF_WEBHOOK_URL=
